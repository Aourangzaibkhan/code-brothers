{
  "name": "code-brothers",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source visual automation + AI assistant platform",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && npm run build --workspace=@code-brothers/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify:templates": "node scripts/verify-templates.mjs",
    "verify:templates:debug": "CB_VERIFY_DEBUG=1 node scripts/verify-templates.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify:dashboard-proxy": "node scripts/verify-dashboard-proxy.mjs",
    "verify:ai-chat": "node scripts/verify-ai-chat.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
