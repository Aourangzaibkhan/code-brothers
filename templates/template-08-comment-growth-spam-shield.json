{
  "id": "template-08-comment-growth-spam-shield",
  "name": "AI Comment Growth & Spam Shield",
  "description": "Spec Section 10 #8. Every 15 minutes: fetch new YouTube comments -> AI classification (spam / lead / question) -> spam is hidden, leads get a reply with the purchase link, questions get a natural AI answer in the viewer language. Classification is keyword-based (links = spam, price/order/buy = lead, otherwise question); the question reply is a canned holding reply \u2014 wire the /api/ai/chat endpoint for real AI answers.",
  "nodes": [
    {
      "id": "trigger",
      "type": "core.cronTrigger",
      "name": "Every 15 Minutes",
      "parameters": {
        "expression": "*/15 * * * *"
      }
    },
    {
      "id": "fetch",
      "type": "core.httpRequest",
      "name": "Fetch YouTube Comments",
      "parameters": {
        "method": "GET",
        "url": "{{ $vars.youtubeApiBaseUrl }}/youtube/v3/commentThreads?part=snippet&videoId={{ $vars.monitoredVideoId }}&maxResults=50",
        "responseType": "json"
      }
    },
    {
      "id": "loop",
      "type": "core.loop",
      "name": "Each Comment",
      "parameters": {
        "arrayField": "items"
      }
    },
    {
      "id": "classify",
      "type": "core.switch",
      "name": "Spam / Lead / Question",
      "parameters": {
        "value": "{{ $json.classification }}",
        "cases": [
          {
            "match": "spam"
          },
          {
            "match": "lead"
          },
          {
            "match": "question"
          }
        ]
      }
    },
    {
      "id": "hide-spam",
      "type": "core.httpRequest",
      "name": "Hide Spam Comment",
      "parameters": {
        "method": "POST",
        "url": "{{ $vars.youtubeApiBaseUrl }}/youtube/v3/comments/setModerationStatus",
        "body": {
          "id": "{{ $json.commentId }}",
          "moderationStatus": "rejected"
        },
        "responseType": "json"
      }
    },
    {
      "id": "reply-lead",
      "type": "youtube.replyComment",
      "name": "Reply to Lead",
      "parameters": {
        "commentId": "{{ $json.commentId }}",
        "text": "Thanks for watching! You can order here: {{ $vars.productLink }}"
      }
    },
    {
      "id": "reply-question",
      "type": "youtube.replyComment",
      "name": "Reply to Question",
      "parameters": {
        "commentId": "{{ $json.commentId }}",
        "text": "Thanks for watching! We will get back to you with an answer shortly."
      }
    },
    {
      "id": "unwrap",
      "type": "core.setData",
      "name": "Unwrap Comment List",
      "parameters": {
        "assignments": [
          {
            "name": "items",
            "value": "{{ $json.body.items }}"
          }
        ]
      }
    },
    {
      "id": "classify-comment",
      "type": "core.setData",
      "name": "Classify Comment",
      "parameters": {
        "assignments": [
          {
            "name": "commentId",
            "value": "{{ $json.snippet.topLevelComment.id }}"
          },
          {
            "name": "commentText",
            "value": "{{ $json.snippet.topLevelComment.snippet.textDisplay }}"
          },
          {
            "name": "classification",
            "value": "{{ (($json.snippet.topLevelComment.snippet.textDisplay || '').toLowerCase().includes('http') || ($json.snippet.topLevelComment.snippet.textDisplay || '').toLowerCase().includes('www.')) ? 'spam' : ((($json.snippet.topLevelComment.snippet.textDisplay || '').toLowerCase().includes('price') || ($json.snippet.topLevelComment.snippet.textDisplay || '').toLowerCase().includes('order') || ($json.snippet.topLevelComment.snippet.textDisplay || '').toLowerCase().includes('buy')) ? 'lead' : 'question') }}"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "to": "fetch"
    },
    {
      "from": "classify",
      "output": 0,
      "to": "hide-spam"
    },
    {
      "from": "classify",
      "output": 1,
      "to": "reply-lead"
    },
    {
      "from": "classify",
      "output": 2,
      "to": "reply-question"
    },
    {
      "from": "fetch",
      "to": "unwrap"
    },
    {
      "from": "unwrap",
      "to": "loop"
    },
    {
      "from": "loop",
      "to": "classify-comment"
    },
    {
      "from": "classify-comment",
      "to": "classify"
    }
  ],
  "settings": {
    "timezone": "Asia/Karachi",
    "variables": {
      "monitoredVideoId": "",
      "productLink": "https://your-store.example/product",
      "youtubeApiBaseUrl": "https://www.googleapis.com"
    }
  }
}
