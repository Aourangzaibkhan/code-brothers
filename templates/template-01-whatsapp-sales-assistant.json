{
  "id": "template-01-whatsapp-sales-assistant",
  "name": "Multilingual WhatsApp AI Sales Assistant (Voice + Text)",
  "description": "Spec Section 10 #1. Incoming WhatsApp text or voice note -> Whisper transcription (AI media worker) -> RAG catalog search -> stock check -> answer in the customer language, collect address and create a Shopify draft order. Voice branch and text branch merge at \"Normalize Question\". Text branch is the verified path; the voice branch resolves the voice note to a media URL first (whatsapp.downloadMedia) and the worker transcribes it.",
  "nodes": [
    {
      "id": "trigger",
      "type": "core.webhookTrigger",
      "name": "WhatsApp Incoming Message",
      "parameters": {
        "path": "whatsapp/incoming",
        "method": "POST"
      }
    },
    {
      "id": "switch-type",
      "type": "core.switch",
      "name": "Text or Voice?",
      "parameters": {
        "value": "{{ $json.messageType }}",
        "cases": [
          {
            "match": "audio"
          },
          {
            "match": "text"
          }
        ]
      }
    },
    {
      "id": "transcribe",
      "type": "core.httpRequest",
      "name": "Transcribe Voice Note",
      "parameters": {
        "method": "POST",
        "url": "{{ $vars.mediaWorkerBaseUrl }}/transcribe",
        "body": {
          "mediaUrl": "{{ $json.mediaUrl }}",
          "language": "{{ $json.language }}"
        },
        "responseType": "json"
      }
    },
    {
      "id": "normalize",
      "type": "core.setData",
      "name": "Normalize Question",
      "parameters": {
        "assignments": [
          {
            "name": "question",
            "value": "{{ ($node[\"Transcribe Voice Note\"] && $node[\"Transcribe Voice Note\"].json.body.text) || $json.text }}"
          },
          {
            "name": "customerPhone",
            "value": "{{ $json.from }}"
          },
          {
            "name": "language",
            "value": "{{ $json.language }}"
          }
        ]
      }
    },
    {
      "id": "catalog-search",
      "type": "core.httpRequest",
      "name": "Search Catalog (RAG)",
      "parameters": {
        "method": "POST",
        "url": "{{ $vars.apiBaseUrl }}/api/rag/search",
        "body": {
          "query": "{{ $json.question }}",
          "limit": 3
        },
        "responseType": "json"
      }
    },
    {
      "id": "check-stock",
      "type": "core.if",
      "name": "In Stock?",
      "parameters": {
        "left": "{{ $json.body.results[0].stock }}",
        "operator": "gt",
        "right": 0
      }
    },
    {
      "id": "reply-answer",
      "type": "whatsapp.sendMessage",
      "name": "Send Answer + Price",
      "parameters": {
        "to": "{{ $json.customerPhone }}",
        "body": "{{ $json.body.results[0].answer }}\nPrice: {{ $json.body.results[0].price }}"
      }
    },
    {
      "id": "ask-address",
      "type": "whatsapp.sendMessage",
      "name": "Collect Delivery Address",
      "parameters": {
        "to": "{{ $json.customerPhone }}",
        "body": "To place your order, please reply with your full delivery address."
      }
    },
    {
      "id": "create-order",
      "type": "shopify.createDraftOrder",
      "name": "Create Draft Order",
      "parameters": {
        "lineItemsJson": "{{ $json.body.results[0].lineItemsJson }}"
      }
    },
    {
      "id": "confirm-order",
      "type": "whatsapp.sendMessage",
      "name": "Confirm Order",
      "parameters": {
        "to": "{{ $json.customerPhone }}",
        "body": "Your order has been created. Order reference: {{ $json.id }}"
      }
    },
    {
      "id": "reply-oos",
      "type": "whatsapp.sendMessage",
      "name": "Send Out-of-Stock Reply",
      "parameters": {
        "to": "{{ $json.customerPhone }}",
        "body": "Sorry, this item is out of stock right now. We will message you as soon as it is back."
      }
    },
    {
      "id": "download-media",
      "type": "whatsapp.downloadMedia",
      "name": "Resolve Voice Note URL",
      "parameters": {
        "mediaId": "{{ $json.mediaId }}"
      }
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "to": "switch-type"
    },
    {
      "from": "switch-type",
      "output": 1,
      "to": "normalize"
    },
    {
      "from": "transcribe",
      "to": "normalize"
    },
    {
      "from": "normalize",
      "to": "catalog-search"
    },
    {
      "from": "catalog-search",
      "to": "check-stock"
    },
    {
      "from": "check-stock",
      "output": 0,
      "to": "reply-answer"
    },
    {
      "from": "check-stock",
      "output": 1,
      "to": "reply-oos"
    },
    {
      "from": "reply-answer",
      "to": "ask-address"
    },
    {
      "from": "ask-address",
      "to": "create-order"
    },
    {
      "from": "create-order",
      "to": "confirm-order"
    },
    {
      "from": "switch-type",
      "output": 0,
      "to": "download-media"
    },
    {
      "from": "download-media",
      "to": "transcribe"
    }
  ],
  "settings": {
    "timezone": "Asia/Karachi",
    "variables": {
      "mediaWorkerBaseUrl": "http://ai-media-worker:8000",
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
