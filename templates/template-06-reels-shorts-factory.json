{
  "id": "template-06-reels-shorts-factory",
  "name": "1-Click Long Video to 5 Reels/Shorts Factory",
  "description": "Transcribe a long video, cut one Short/Reel per transcription segment, upload each to YouTube Shorts and publish it as an Instagram Reel. (Clip boundaries come from the transcription segments \u2014 the media worker does not pick 'viral' moments.)",
  "nodes": [
    {
      "id": "trigger",
      "type": "core.manualTrigger",
      "name": "Drop Long Video",
      "parameters": {
        "payload": {
          "sourcePath": "",
          "language": "en"
        }
      }
    },
    {
      "id": "transcribe",
      "type": "core.httpRequest",
      "name": "Transcribe (Whisper)",
      "parameters": {
        "method": "POST",
        "url": "{{ $vars.mediaWorkerBaseUrl }}/transcribe",
        "body": {
          "filePath": "{{ $json.sourcePath }}",
          "language": "{{ $json.language }}"
        },
        "responseType": "json"
      }
    },
    {
      "id": "pick-clips",
      "type": "core.setData",
      "name": "AI Picks Top 5 Clips",
      "parameters": {
        "assignments": [
          {
            "name": "clips",
            "value": "{{ $json.body.segments.map(s => ({ start: s.start, duration: Math.max(1, Math.round((s.end - s.start) * 10) / 10), title: s.text.trim(), description: s.text.trim() })) }}"
          }
        ]
      }
    },
    {
      "id": "loop",
      "type": "core.loop",
      "name": "Each Clip",
      "parameters": {
        "arrayField": "clips"
      }
    },
    {
      "id": "clip",
      "type": "core.httpRequest",
      "name": "Crop 9:16 + Burn Captions",
      "parameters": {
        "method": "POST",
        "url": "{{ $vars.mediaWorkerBaseUrl }}/video/clip",
        "body": {
          "inputPath": "{{ $node[\"Drop Long Video\"].json.sourcePath }}",
          "start": "{{ $json.start }}",
          "duration": "{{ $json.duration }}",
          "captions": "{{ $json.captionsPath }}"
        },
        "responseType": "json"
      }
    },
    {
      "id": "yt-upload",
      "type": "youtube.uploadVideo",
      "name": "Upload YouTube Short",
      "parameters": {
        "title": "{{ $json.title }}",
        "description": "{{ $json.description }}",
        "privacyStatus": "public",
        "tags": "shorts",
        "contentBase64": "{{ $json.body.contentBase64 }}",
        "contentType": "video/mp4"
      }
    },
    {
      "id": "ig-publish",
      "type": "instagram.publishPost",
      "name": "Publish Instagram Reel",
      "parameters": {
        "videoUrl": "{{ $json.body.publicUrl }}",
        "mediaType": "REELS",
        "caption": "{{ $json.title }}"
      }
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "to": "transcribe"
    },
    {
      "from": "transcribe",
      "to": "pick-clips"
    },
    {
      "from": "pick-clips",
      "to": "loop"
    },
    {
      "from": "loop",
      "to": "clip"
    },
    {
      "from": "clip",
      "to": "yt-upload"
    },
    {
      "from": "yt-upload",
      "to": "ig-publish"
    }
  ],
  "settings": {
    "timezone": "Asia/Karachi",
    "variables": {
      "mediaWorkerBaseUrl": "http://ai-media-worker:8000"
    }
  }
}
