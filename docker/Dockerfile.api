# Code Brothers API — multi-stage build, non-root runtime.
# Build context: repository root.
#   docker build -f docker/Dockerfile.api -t code-brothers-api .
FROM node:20-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
RUN npm prune --omit=dev && npm cache clean --force
# The node:20-alpine image ships an unprivileged "node" user — never run as root.
USER node
EXPOSE 3000
CMD ["node", "apps/api/dist/server.js"]
